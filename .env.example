# Required
BOT_TOKEN=123456:your_bot_token
API_ID=123456
API_HASH=your_api_hash
DATABASE_URI=mongodb+srv://username:db-password@cluster.mongodb.net/
LOG_CHANNEL=-1001234567890
ADMINS=123456789

# Recommended
CHANNELS=-1001234567890
BIN_CHANNEL=-1001234567890
DATABASE_NAME=Cluster0
COLLECTION_NAME=dreamcinezone_files

# Web and streaming
PORT=8080
FQDN=your-app-name.onrender.com
HAS_SSL=True
NO_PORT=True
STREAM_MODE=True
PREMIUM_STREAM_MODE=False

# Force subscription
AUTH_CHANNELS=-1001234567890
AUTH_REQ_CHANNELS=-1001234567890
REQST_CHANNEL_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
SUPPORT_CHAT=https://t.me/your_support_group

# Optional features
IS_VERIFY=False
MAINTENANCE=False
TMDB_API_KEY=
SHORTENER_WEBSITE=
SHORTENER_API=

# Clone-bot token encryption. Generate with: python3 generate_clone_key.py
# Keep this value unchanged across restarts; losing it prevents clone tokens
# already stored in MongoDB from being decrypted.
CLONE_ENCRYPTION_KEY=
MAX_CLONES_PER_USER=3
MAX_TOTAL_CLONES=10
SHORTENER_WEBSITE2=
SHORTENER_API2=
TUTORIAL=https://t.me/your_tutorial
TUTORIAL_2=
TUTORIAL_3=
AUTO_DELETE=True
DELETE_TIME=300
PROTECT_CONTENT=False

# Backward-compatible aliases accepted by info.py: FILE_STORE_CHANNEL, AUTH_CHANNEL, AUTH_GROUPS,
# REQST_CHANNEL, VERIFY, SHORTLINK_URL, SHORTLINK_API, SECOND_SHORTLINK_URL, SECOND_SHORTLINK_API
